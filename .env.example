# Dynamic DNS hostname to monitor (Required)
HOSTNAME=your-dynamic-hostname.ddns.net

# Port configuration (Specify multiple ports with comma or a single PORT)
# Example multi-port:
PORTS=3306, 80, 443
# Alternatively for single port:
# PORT=3306

# Update interval in minutes (Optional, default: 5)
UPDATE_INTERVAL_MINUTES=5

# State and log files
STATE_FILE=/tmp/ip_state.json
LOG_FILE=/var/log/ufw-ip-updater.log
PID_FILE=/tmp/ufw-ip-updater.pid

# Log rotation configuration
MAX_LOG_SIZE_MB=10
MAX_LOG_FILES=5
